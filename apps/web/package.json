{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --base ./",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "icons:tauri": "node scripts/generateTauriIcons.mjs",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:add:android": "npx cap add android",
    "tauri": "tauri",
    "tauri:dev": "npm run icons:tauri && tauri dev",
    "tauri:build": "npm run icons:tauri && tauri build"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@monaco-editor/react": "^4.7.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "phaser": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
