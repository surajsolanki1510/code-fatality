# Production env templates (never commit real secrets)

## Neon
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

## Render API (preferred free-friendly API host)
PORT=4000
NODE_ENV=production
JWT_SECRET=replace-with-long-random-32plus-chars
JWT_EXPIRES_IN=30d
CORS_ORIGIN=https://code-fatality.vercel.app
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

## Vercel Web
VITE_API_URL=https://YOUR-API.onrender.com
